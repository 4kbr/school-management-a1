# SERVER
# Port server API (termasuk prefix ":")
API_PORT=":3000"

# TLS (self-signed untuk development, path relatif dari CWD backend/)
# Generate: lihat backend/docs/command.md
TLS_CERT="cert.pem"
TLS_KEY="key.pem"

# DATABASE (MariaDB via docker compose — lihat backend/docker-compose.yml)
DB_USER="app"
DB_PASSWORD="app_password"
DB_NAME="school_management"
DB_PORT=3306
DB_HOST=127.0.0.1

# AUTH (JWT)
# Secret untuk sign/verify token JWT. Ganti dengan nilai acak kuat di production.
JWT_SECRET="change-me-in-production"
# Umur token dalam menit (mis. 60 = 1 jam)
JWT_EXPIRY_MIN=60
# Secure attribute pada cookie. false saat dev (cert self-signed bikin browser
# menolak cookie Secure di localhost), true saat production via HTTPS.
COOKIE_SECURE=false
